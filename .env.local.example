# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 커밋되지 않는다.
# 전부 서버 전용이며 클라이언트 번들에는 주입되지 않는다(vite.config.ts 참고).

# 필수 ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# 쉼표로 구분한 회원 코드. 비어 있으면 서버가 모든 요청을 거부한다.
# node generate-member-codes.mjs 로 만든다. 절대 커밋하지 말 것.
MEMBER_CODES=

# 선택 ─────────────────────────────────────────────────────────────
# 헤어 생성 모델. 상위 티어가 오히려 정체성을 무너뜨린 적이 있어 함부로 올리지 말 것.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 진단·추천 모델
# GEMINI_TEXT_MODEL=gemini-3.6-flash

# 동일인 판정 모델. flash 계열은 같은 성별·연령대의 다른 얼굴을 통과시킨다.
# IDENTITY_MODEL=gemini-3.1-pro-preview

# off 로 두면 동일인 검증을 건너뛴다(세션당 약 30% 비용과 8초 절약, 품질 하한 없음).
# IDENTITY_CHECK=off

# 피부 보정 강도: subtle / medium / strong
# RETOUCH_LEVEL=medium

# 코드별 하루 생성 횟수
# DAILY_LIMIT_PER_CODE=20

# 코드별 하루 추천 횟수. 지정하지 않으면 생성 한도의 2배.
# DAILY_RECOMMEND_LIMIT=40
